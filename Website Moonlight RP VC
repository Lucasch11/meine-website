<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moonlight RP | VC🎙🇩🇪</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #ff4dd8; /* Neon-Lila Hintergrund */
      color: #fff;
      text-align: center;
      padding: 40px;
      margin: 0;
    }

    header {
      font-size: 42px;
      font-weight: bold;
      color: #000; /* Schwarz für besseren Kontrast */
      margin-bottom: 10px;
    }

    .btn {
      display: inline-block;
      margin: 20px;
      padding: 12px 20px;
      background: #fff;
      color: #000;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
    }

    .card {
      max-width: 700px;
      margin: 20px auto;
      padding: 20px;
      background: #222;
      border-radius: 10px;
      box-sizing: border-box;
    }

    h2 {
      color: #fff;
      margin-top: 0;
    }

    ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    ul li {
      padding: 6px 0;
      font-size: 18px;
    }

    .role {
      color: #fff;
      font-weight: bold;
      margin-top: 15px;
      margin-bottom: 10px;
    }
  </style>
</head>
<body>
  <header>Moonlight RP | VC🎙🇩🇪</header>
  <p>Willkommen auf unserem Roleplay-Server!</p>

  <a class="btn" href="https://discord.gg/eJPByX9bFk" target="_blank" rel="noopener noreferrer">Discord beitreten</a>

  <div class="card">
    <h2>Features</h2>
    <p>Fraktionen, Fahrzeuge, Wirtschaftssystem und spannende Events.</p>
  </div>

  <div class="card">
    <h2>Team</h2>

    <p class="role">Founder</p>
    <ul>
      <li>Jaiden</li>
      <li>Flei</li>
      <li>Leyscery</li>
    </ul>

    <p class="role">Inhaber</p>
    <ul>
      <li>Jarno</li>
    </ul>

    <p class="role">Stv Inhaber</p>
    <ul>
      <li>Finn</li>
      <li>Zeus</li>
    </ul>

    <p class="role">Owner</p>
    <ul>
      <li>Verfügbar</li>
    </ul>

    <p class="role">Stv Owner</p>
    <ul>
      <li>Verfügbar</li>
    </ul>
  </div>
</body>
</html>
