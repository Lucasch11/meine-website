<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moonlight RP | VC🎙🇩🇪</title>
  <style>
    :root {
      --bg-deep: #07030f;
      --bg-purple: #22042f;
      --neon: #ff4ef7;
      --neon-2: #b517ff;
      --text: #f7ebff;
      --card: rgba(20, 10, 28, 0.8);
      --button: #ffffff;
      --button-text: #090909;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background:
        radial-gradient(circle at center, rgba(168, 48, 255, 0.32), transparent 35%),
        radial-gradient(circle at top, rgba(255, 80, 220, 0.18), transparent 28%),
        linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-purple) 100%);
      color: var(--text);
      text-align: center;
      padding: 40px 20px;
    }

    .hero {
      max-width: 900px;
      margin: 0 auto 30px;
      padding: 25px 15px 0;
    }

    .logo {
      margin: 0;
      font-size: clamp(3rem, 9vw, 8.5rem);
      line-height: 0.9;
      letter-spacing: 2px;
      font-weight: 900;
      text-transform: uppercase;
      color: #f6d8ff;
      text-shadow:
        0 0 6px rgba(255, 150, 255, 0.9),
        0 0 18px rgba(255, 78, 247, 0.9),
        0 0 30px rgba(181, 23, 255, 0.9),
        0 0 42px rgba(181, 23, 255, 0.75),
        0 0 62px rgba(181, 23, 255, 0.5);
      filter: drop-shadow(0 0 12px rgba(255, 78, 247, 0.6));
    }

    .subtitle {
      margin-top: 10px;
      font-size: 1.2rem;
      letter-spacing: 2px;
      color: #f5d9ff;
      opacity: 0.9;
    }

    .btn {
      display: inline-block;
      margin: 18px 0 12px;
      padding: 14px 26px;
      background: var(--button);
      color: var(--button-text);
      text-decoration: none;
      border-radius: 12px;
      font-weight: bold;
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.7);
    }

    .card {
      max-width: 700px;
      margin: 24px auto;
      padding: 22px 18px;
      background: var(--card);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    h2 {
      color: #fff;
      margin-top: 0;
      font-size: 2rem;
    }

    p {
      font-size: 1.05rem;
      line-height: 1.6;
    }

    ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    ul li {
      padding: 6px 0;
      font-size: 1.1rem;
    }

    .role {
      color: var(--text);
      font-weight: bold;
      margin-top: 18px;
      margin-bottom: 10px;
      font-size: 1.1rem;
      letter-spacing: 1px;
    }
  </style>
</head>
<body>
  <div class="hero">
    <h1 class="logo">Moonlight</h1>
    <div class="subtitle">RP | VC🎙🇩🇪</div>
  </div>

  <p>Willkommen auf unserem Roleplay-Server!</p>

  <a class="btn" href="https://discord.gg/eJPByX9bFk" target="_blank" rel="noopener noreferrer">Discord beitreten</a>

  <div class="card">
    <h2>Features</h2>
    <p>Fraktionen, Fahrzeuge, Wirtschaftssystem und spannende Events.</p>
  </div>

  <div class="card">
    <h2>Team</h2>

    <p class="role">Founder</p>
    <ul>
      <li>Jaiden</li>
      <li>Flei</li>
      <li>Leyscery</li>
    </ul>

    <p class="role">Inhaber</p>
    <ul>
      <li>Jarno</li>
    </ul>

    <p class="role">Stv Inhaber</p>
    <ul>
      <li>Finn</li>
      <li>Zeus</li>
    </ul>

    <p class="role">Owner</p>
    <ul>
      <li>Verfügbar</li>
    </ul>

    <p class="role">Stv Owner</p>
    <ul>
      <li>Verfügbar</li>
    </ul>
  </div>
</body>
</html>
